---
import Layout from "../components/layout.jsx";
const title = "Home";
const description = "Fast facts for fuller findings. Collections of data for greater convenience and deeper analysis.";
---
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="glance, guide, data, table, information, statistics, visual, reference" />
  <title>StatJam - Projects involving hierarchical information and data visualisation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" type="text/css" href="/styles/ataglance4.css">
  <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,700|Roboto+Condensed:300,400,700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900" rel="stylesheet">
  <style type="text/css">
body {
    margin: 0;
  display: grid;
  grid-template-rows: auto 1fr auto;
  align-items: start;
  min-height: 100vh;
  background-color: #3a3042;
}
span.text-sm {
    font-size: 16px;
    letter-spacing: 0;
}
footer {
  display: flex;
  flex-flow: row wrap;
  position:relative;
  background-color: transparent;
  min-height:unset;
}
footer > * {
  flex:  1 100%;
}
footer::after {
    position: fixed;
    content: '';
    display: block;
    height: 42vh;
    width: 100%;
    background: linear-gradient(0deg, rgba(0,0,0,.75) 0%, transparent);
    bottom: 0;
    left: 0;
    z-index: -1;
}
@media screen and (min-width:768px) {
h1 span:first-of-type {
        position:relative;
        top:17px;
        margin:0 -1px 0 -12px;
        font-size:120%;
    }
.bg-aag-motif {
    background-image: url(../img/backgrounds/ataglance-home-banner.svg);
    background-size: 50%;
    background-position: 90% center;
    }
}
@media screen and (min-width:992px) {
.bg-aag-motif {
    background-size: contain;
    }
}
  </style>
</head>

<Layout>
  <main>
    <!-- Adapted main content from src/index.html -->
    <div class="main-content m-0 p-0 p-4 shade-25">
      <div class="bg-aag-motif m-auto d-flex justify-content-center pt-4" style="max-width:1200px;">
        <div class="row" style="min-height:400px;">
          <div class="col-xs-12 col-md-6">
            <div class="mvm align-center-then-left text-light">
              <h3 class="display-1 mhs pvm text-lighter">At A Glance</h3>
              <p class="width-95 text-up1">Collections of hierarchical information brought together in practical ways for greater convenience and analysis.</p>
              <p class="width-95 text-up1 mhs">From historical chronologies to ranked tables and statistical results - categories range from People &amp; Politics to Culture &amp; Entertainment, Sport &amp; Recreation to Travel &amp; Transport, Art &amp; Design to Nature &amp; Science.
              </p>
              <a href="/ataglance/" class="link-button hue-emerlite mas my-4 text-up2 swing">At A Glance homepage</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Bootstrap JS and dependencies (loaded in dev and production as needed) -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"  crossorigin="anonymous"></script>
</Layout>
