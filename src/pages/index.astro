---
import BaseLayout from "../components/base-layout.astro";
const title = "Home";
---
<BaseLayout title={title}>
    <div class="main-content m-0 p-0 p-4 shade-25">
      <div class="bg-aag-motif home-banner m-auto d-flex justify-content-center pt-4">
        <div class="row home-row">
          <div class="col-xs-12 col-md-6">
            <div class="mvm align-center-then-left text-light">
              <h1 class="display-1 mhs pvm text-lighter">At A Glance</h1>
              <p class="width-95 text-up1">Collections of hierarchical information brought together in practical ways for greater convenience and analysis.</p>
              <p class="width-95 text-up1 mhs">From historical chronologies to ranked tables and statistical results - categories range from People &amp; Politics to Culture &amp; Entertainment, Sport &amp; Recreation to Travel &amp; Transport, Art &amp; Design to Nature &amp; Science.
              </p>
              <a href="/ataglance/" class="link-button hue-emerlite mas my-4 text-up2 swing">At A Glance homepage</a>
            </div>
          </div>
        </div>
      </div>
    </div>

  <!-- Bootstrap JS and dependencies (loaded in dev and production as needed) -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"  crossorigin="anonymous"></script>
</BaseLayout>
