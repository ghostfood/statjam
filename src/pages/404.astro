---
import BaseLayout from "../components/base-layout.astro";
---

<BaseLayout title="404">
    <div class="not-found-page grad-shade">
        <div class="container container-xl py-4">
          <div class="row align-center">
            <div class="col-12">
              <h1>Error 404</h1>
              <h2>Not much to see here!</h2>
            </div>
          </div>

              <div class="row" style="min-height: 300px;">
                <div class="col-12">
                  <div class="clip-circle aligner">
                    <div id="lid" class="eye align-center width-95">
                      <div class="iris"></div>
                    </div>
                  </div>

                  <p class="width-100-then-50 px-5 align-center text-up2">
                    What you're looking for may have been removed, relocated or renamed but you may find it from the <br>
                                  <a href="/ataglance/" class="link-button hue-emerlite mas my-4 text-up2">At A Glance homepage</a>

                  </p>

                  <p class="width-100-then-50 align-center text-faint mt-5">
                    Animation adapted from <a href="https://codepen.io/tendollars/pen/QONoRx">eye/css</a> by <a href="https://codepen.io/tendollars/">@tendollars</a>
                  </p>
                </div>
            </div>
      </div>
    </div>
</BaseLayout>
